<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Nightwire/UI/EpisodeLibraryView.uss" />
    <ui:VisualElement name="library-root" class="library-root">
        <ui:VisualElement class="top-glow" />
        <ui:VisualElement class="header">
            <ui:VisualElement class="brand-row">
                <ui:Label text="NIGHTWIRE" class="wordmark" />
                <ui:Label text="EPISODE ARCHIVE" class="eyebrow" />
            </ui:VisualElement>
            <ui:Label text="Your story library" class="page-title" />
            <ui:Label name="catalogue-status" text="Connect to check for new episodes" class="status-copy" />
        </ui:VisualElement>
        <ui:VisualElement class="toolbar">
            <ui:Button name="refresh-button" text="REFRESH" class="button button-primary" />
            <ui:Button name="cancel-button" text="CANCEL DOWNLOAD" class="button button-quiet" />
        </ui:VisualElement>
        <ui:ScrollView name="episode-list" class="episode-list" />
        <ui:VisualElement name="empty-state" class="empty-state">
            <ui:Label text="NO EPISODES FOUND" class="empty-title" />
            <ui:Label text="Refresh the archive to discover available chapters." class="empty-copy" />
        </ui:VisualElement>
        <ui:VisualElement class="footer">
            <ui:Label text="OFFLINE PLAY AVAILABLE FOR INSTALLED EPISODES" class="footer-copy" />
            <ui:VisualElement class="footer-indicator" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
