.messenger-root {
    flex-grow: 1;
    min-height: 100%;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 14px;
    background-color: rgb(6, 9, 18);
    color: rgb(235, 239, 250);
}
.ambient-glow {
    position: absolute;
    top: -180px;
    left: 20%;
    width: 340px;
    height: 280px;
    border-radius: 100%;
    background-color: rgba(98, 65, 171, 0.12);
}
.messenger-header {
    flex-direction: row;
    align-items: center;
    min-height: 62px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(37, 45, 65);
}
.back-button {
    width: 92px;
    height: 36px;
    margin-right: 12px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgb(20, 26, 42);
    color: rgb(187, 166, 237);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(48, 55, 78);
    border-bottom-color: rgb(48, 55, 78);
    border-left-color: rgb(48, 55, 78);
    border-right-color: rgb(48, 55, 78);
    border-radius: 4px;
    font-size: 9px;
    -unity-font-style: bold;
}
.contact-block { flex-grow: 1; }
.contact-name {
    color: rgb(245, 246, 255);
    font-size: 16px;
    -unity-font-style: bold;
}
.contact-status {
    color: rgb(137, 150, 177);
    font-size: 8px;
    letter-spacing: 1px;
    margin-top: 4px;
}
.contact-mark {
    width: 38px;
    height: 38px;
    padding-top: 10px;
    border-radius: 19px;
    background-color: rgb(42, 32, 70);
    color: rgb(203, 177, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.conversation-divider {
    align-items: center;
    padding-top: 16px;
    padding-bottom: 12px;
}
.episode-kicker {
    color: rgb(170, 132, 241);
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}
.archive-note {
    color: rgb(91, 105, 132);
    font-size: 7px;
    letter-spacing: 1px;
    margin-top: 5px;
}
.message-list {
    flex-grow: 1;
    padding-top: 8px;
    padding-bottom: 10px;
}
.message-row {
    width: 100%;
    flex-direction: row;
    margin-bottom: 11px;
    align-items: flex-end;
}
.message-row-outgoing { justify-content: flex-end; }
.message-row-incoming { justify-content: flex-start; }
.message-bubble {
    max-width: 84%;
    padding-left: 13px;
    padding-right: 13px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 10px;
    background-color: rgb(19, 27, 44);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(39, 50, 73);
    border-bottom-color: rgb(39, 50, 73);
    border-left-color: rgb(39, 50, 73);
    border-right-color: rgb(39, 50, 73);
}
.message-bubble-outgoing {
    background-color: rgb(48, 36, 77);
    border-top-color: rgb(80, 59, 124);
    border-bottom-color: rgb(80, 59, 124);
    border-left-color: rgb(80, 59, 124);
    border-right-color: rgb(80, 59, 124);
}
.message-sender {
    color: rgb(174, 145, 236);
    font-size: 8px;
    letter-spacing: 1px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}
.message-body {
    color: rgb(230, 234, 246);
    font-size: 13px;
    white-space: normal;
}
.message-media-note {
    color: rgb(170, 178, 201);
    font-size: 10px;
    margin-top: 5px;
}
.message-image {
    width: 100%;
    max-height: 250px;
    margin-top: 7px;
    border-radius: 6px;
}
.message-time {
    color: rgb(105, 118, 145);
    font-size: 7px;
    margin-top: 6px;
    -unity-text-align: right;
}
.choice-prompt {
    color: rgb(230, 232, 245);
    font-size: 13px;
    margin-bottom: 9px;
}
.choice-button {
    min-height: 42px;
    margin-bottom: 7px;
    background-color: rgb(42, 32, 69);
    color: rgb(235, 229, 255);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(102, 76, 157);
    border-bottom-color: rgb(102, 76, 157);
    border-left-color: rgb(102, 76, 157);
    border-right-color: rgb(102, 76, 157);
    border-radius: 5px;
    font-size: 11px;
    white-space: normal;
}
.choice-button:hover { background-color: rgb(61, 45, 96); }
.typing-indicator {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    height: 24px;
}
.typing-dots {
    color: rgb(178, 147, 242);
    font-size: 18px;
    margin-right: 7px;
}
.typing-label {
    color: rgb(99, 113, 142);
    font-size: 7px;
    letter-spacing: 1px;
}
.response-dock {
    padding-top: 11px;
    border-top-width: 1px;
    border-top-color: rgb(37, 45, 65);
}
.response-heading {
    color: rgb(145, 120, 198);
    font-size: 8px;
    letter-spacing: 1.5px;
    margin-bottom: 7px;
}
.choice-list { flex-direction: column; }
.conversation-status {
    color: rgb(99, 112, 139);
    font-size: 9px;
    white-space: normal;
}
.back-button, .choice-button {
    transition-property: background-color, scale, opacity;
    transition-duration: 140ms;
    transition-timing-function: ease-out;
}
.back-button:hover { background-color: rgb(31, 39, 60); }

.message-media-player {
    margin-top: 8px;
    padding: 10px;
    background-color: rgba(18, 24, 43, 0.92);
    border-radius: 12px;
}

.message-media-status {
    color: rgb(158, 169, 197);
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.message-media-control {
    min-height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(238, 240, 250);
    background-color: rgb(73, 63, 125);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.message-video-preview {
    width: 100%;
    height: 180px;
    margin-bottom: 8px;
    background-color: rgb(5, 8, 16);
}


.profile-open-button {
    align-self: flex-start;
    margin-top: 5px;
    padding: 4px 9px;
    background-color: rgba(105, 91, 170, 0.18);
    border-width: 1px;
    border-color: rgba(166, 151, 230, 0.35);
    border-radius: 5px;
    color: #c8baff;
    font-size: 10px;
    letter-spacing: 1px;
}

.profile-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    padding: 24px;
    background-color: rgba(3, 5, 13, 0.88);
}

.profile-card {
    width: 100%;
    max-width: 520px;
    padding: 22px;
    background-color: #111426;
    border-width: 1px;
    border-color: rgba(157, 139, 222, 0.45);
    border-radius: 12px;
}

.profile-close-button {
    align-self: flex-end;
    color: #c8baff;
    background-color: rgba(105, 91, 170, 0.2);
    border-width: 1px;
    border-color: rgba(166, 151, 230, 0.35);
}

.profile-name {
    margin-top: 16px;
    color: #f2efff;
    font-size: 24px;
    -unity-font-style: bold;
}

.profile-status {
    margin-top: 6px;
    color: #a99bd7;
    font-size: 11px;
    letter-spacing: 1px;
}

.profile-bio {
    margin-top: 18px;
    color: #d0d2df;
    font-size: 14px;
    white-space: normal;
}


.messenger-tabs {
    flex-direction: row;
    margin-top: 10px;
    margin-bottom: 7px;
    padding: 3px;
    background-color: rgba(15, 20, 35, 0.94);
    border-radius: 8px;
}
.messenger-tab {
    flex-grow: 1;
    min-height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 4px;
    padding-right: 4px;
    color: #8792ad;
    background-color: rgba(35, 42, 62, 0.6);
    border-width: 0;
    border-radius: 6px;
    font-size: 9px;
    -unity-font-style: bold;
}
.messenger-tab-active {
    color: #f0eaff;
    background-color: rgba(105, 77, 158, 0.72);
}
.secondary-content {
    flex-grow: 1;
    padding-top: 8px;
    padding-bottom: 10px;
}
.feed-card, .evidence-card {
    margin-bottom: 12px;
    padding: 13px;
    background-color: rgba(18, 26, 43, 0.96);
    border-width: 1px;
    border-color: rgba(77, 87, 119, 0.58);
    border-radius: 9px;
}
.feed-author {
    color: #c3a9ff;
    font-size: 12px;
    -unity-font-style: bold;
}
.feed-date, .evidence-meta {
    margin-top: 4px;
    margin-bottom: 8px;
    color: #7785a5;
    font-size: 8px;
    letter-spacing: 0.7px;
}
.feed-body, .document-preview {
    color: #e2e6f3;
    font-size: 12px;
    white-space: normal;
}
.feed-comment {
    margin-top: 8px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgba(73, 83, 112, 0.55);
    color: #aeb8d0;
    font-size: 10px;
    white-space: normal;
}
.evidence-title {
    color: #e5ddff;
    font-size: 11px;
    -unity-font-style: bold;
}
.evidence-empty {
    margin-top: 22px;
    color: #8d9ab5;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.document-preview {
    margin-top: 8px;
    padding: 10px;
    background-color: rgba(4, 8, 17, 0.82);
    border-radius: 5px;
}

.group-participants {
    margin-top: 8px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    color: #a99bcf;
    background-color: rgba(35, 29, 56, 0.62);
    border-left-width: 2px;
    border-left-color: rgba(168, 132, 232, 0.75);
    font-size: 9px;
    white-space: normal;
}

.call-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; padding: 24px; background-color: rgba(3, 5, 13, 0.98); }
.call-kicker { color: #a58ad9; font-size: 9px; letter-spacing: 2px; -unity-font-style: bold; }
.call-contact { margin-top: 10px; margin-bottom: 18px; color: #f0edfa; font-size: 23px; -unity-font-style: bold; }
.call-visual-frame { width: 100%; max-width: 560px; height: 250px; justify-content: center; align-items: center; background-color: #090d19; border-width: 1px; border-color: rgba(126, 105, 177, 0.55); border-radius: 12px; overflow: hidden; }
.call-video-surface { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; }
.call-audio-avatar { width: 94px; height: 94px; padding-top: 30px; border-radius: 47px; background-color: rgba(89, 66, 133, 0.72); color: #e6dcff; font-size: 25px; -unity-font-style: bold; -unity-text-align: middle-center; }
.call-effect-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; padding: 12px; color: rgba(255, 255, 255, 0.9); background-color: rgba(130, 20, 54, 0); font-size: 17px; letter-spacing: 2px; -unity-font-style: bold; -unity-text-align: middle-center; }
.call-speaker { margin-top: 18px; color: #b9a2e9; font-size: 10px; letter-spacing: 1px; }
.call-subtitle { min-height: 48px; max-width: 560px; margin-top: 8px; color: #f1eff8; font-size: 15px; white-space: normal; -unity-text-align: middle-center; }
.call-timer { margin-top: 14px; color: #8c97b3; font-size: 10px; letter-spacing: 2px; }
.call-status { margin-top: 8px; color: #7f8ba7; font-size: 8px; letter-spacing: 1px; }
.call-retry-button { margin-top: 16px; min-height: 40px; padding-left: 22px; padding-right: 22px; color: #f0eaff; background-color: #493b72; border-width: 1px; border-color: #9a82c8; border-radius: 7px; }
.call-effect-signal_glitch { background-color: rgba(107, 24, 68, 0.34); }
.call-effect-screen_flicker { background-color: rgba(190, 196, 218, 0.24); }
.call-effect-static_burst { background-color: rgba(219, 223, 238, 0.34); }
.call-effect-audio_distortion { background-color: rgba(74, 44, 119, 0.36); }

.minigame-entry-button { margin-top: 10px; min-height: 42px; color: #f0eaff; background-color: rgba(92, 68, 143, 0.82); border-width: 1px; border-color: #9e83d1; border-radius: 7px; font-size: 10px; letter-spacing: 1px; }
.minigame-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: flex-start; align-items: stretch; padding: 26px 20px; background-color: rgba(4, 7, 16, 0.98); }
.minigame-kicker { color: #9278c4; font-size: 9px; letter-spacing: 2px; -unity-font-style: bold; }
.minigame-title { margin-top: 14px; color: #f1edff; font-size: 22px; -unity-font-style: bold; }
.minigame-instructions { margin-top: 10px; margin-bottom: 14px; color: #b9c1d6; font-size: 12px; white-space: normal; }
.minigame-progress { margin-bottom: 14px; color: #a68bdc; font-size: 10px; letter-spacing: 1px; }
.minigame-challenge-content { flex-grow: 1; padding: 12px; background-color: rgba(18, 24, 42, 0.82); border-width: 1px; border-color: rgba(103, 87, 145, 0.55); border-radius: 10px; }
.minigame-feedback { min-height: 42px; margin-top: 12px; color: #d3c5f1; font-size: 11px; white-space: normal; }
.minigame-symbol-button, .minigame-submit-button, .minigame-evidence-button { min-height: 42px; margin: 4px; padding-left: 12px; padding-right: 12px; color: #ece7fa; background-color: rgba(65, 52, 99, 0.9); border-width: 1px; border-color: rgba(154, 128, 202, 0.8); border-radius: 6px; }
.minigame-sequence-preview { min-height: 48px; margin-bottom: 14px; padding: 12px; color: #e5dbff; background-color: rgba(6, 10, 21, 0.9); font-size: 13px; white-space: normal; }
.minigame-submit-button { margin-top: 16px; background-color: #654a96; }
.minigame-continue-button { min-height: 42px; margin-top: 12px; color: #f0eaff; background-color: #493b72; border-width: 1px; border-color: #9a82c8; border-radius: 7px; }
