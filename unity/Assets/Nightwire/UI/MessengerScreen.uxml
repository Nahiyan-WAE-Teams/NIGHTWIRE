<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Nightwire/UI/MessengerScreen.uss" />
    <ui:VisualElement name="messenger-root" class="messenger-root">
        <ui:VisualElement class="ambient-glow" />
        <ui:VisualElement class="messenger-header">
            <ui:Button name="back-button" text="‹ ARCHIVE" class="back-button" />
            <ui:VisualElement class="contact-block">
                <ui:Label name="contact-name" text="NIGHTWIRE CONTACT" class="contact-name" />
                <ui:Label name="contact-status" text="LOCAL STORY CHANNEL · EPISODE CONTENT" class="contact-status" />
                <ui:Button name="profile-open-button" text="VIEW PROFILE" class="profile-open-button" />
            </ui:VisualElement>
            <ui:Label name="contact-mark" text="NW" class="contact-mark" />
        </ui:VisualElement>
        <ui:VisualElement class="conversation-divider">
            <ui:Label name="episode-title" text="THE FIRST SIGNAL" class="episode-kicker" />
            <ui:Label text="MESSAGES ARE STORED WITH YOUR EPISODE" class="archive-note" />
        </ui:VisualElement>
        <ui:VisualElement class="messenger-tabs">
            <ui:Button name="messages-tab" text="MESSAGES" class="messenger-tab messenger-tab-active" />
            <ui:Button name="feed-tab" text="SOCIAL FEED" class="messenger-tab" />
            <ui:Button name="evidence-tab" text="EVIDENCE" class="messenger-tab" />
        </ui:VisualElement>
        <ui:ScrollView name="message-list" class="message-list" />
        <ui:ScrollView name="social-feed-list" class="secondary-content" style="display: none;" />
        <ui:ScrollView name="evidence-list" class="secondary-content" style="display: none;" />
        <ui:VisualElement name="typing-indicator" class="typing-indicator">
            <ui:Label text="..." class="typing-dots" />
            <ui:Label text="INCOMING MESSAGE" class="typing-label" />
        </ui:VisualElement>
        <ui:VisualElement name="response-dock" class="response-dock">
            <ui:Label name="response-heading" text="STORY RESPONSE" class="response-heading" />
            <ui:VisualElement name="choice-list" class="choice-list" />
            <ui:Label name="conversation-status" text="Waiting for the next transmission…" class="conversation-status" />
        </ui:VisualElement>
        <ui:VisualElement name="profile-overlay" class="profile-overlay" style="display: none;">
            <ui:VisualElement class="profile-card">
                <ui:Button name="profile-close-button" text="CLOSE" class="profile-close-button" />
                <ui:Label name="profile-name" text="CONTACT" class="profile-name" />
                <ui:Label name="profile-status" text="OFFLINE" class="profile-status" />
                <ui:Label name="profile-bio" text="No profile information available." class="profile-bio" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
