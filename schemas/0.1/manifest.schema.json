{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nightwire.game/episode/0.1/episode-manifest.schema.json",
  "title": "Episode manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "files",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
          },
          "kind": {
            "enum": [
              "episode_descriptor",
              "character_profile",
              "conversation",
              "event",
              "call",
              "minigame",
              "localization",
              "media",
              "other",
              "character_post"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "type",
          "path",
          "mime_type"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,95}$"
          },
          "type": {
            "enum": [
              "image",
              "audio",
              "video",
              "document"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mime_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          }
        }
      }
    }
  }
}
