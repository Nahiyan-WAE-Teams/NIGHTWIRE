{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nightwire.game/episode/0.1/call.schema.json",
  "title": "Recorded call session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "mode",
    "presentation",
    "participants",
    "duration_ms",
    "media",
    "subtitle_tracks",
    "cues"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "call_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,95}$"
    },
    "mode": {
      "enum": [
        "audio",
        "video"
      ]
    },
    "presentation": {
      "const": "prerecorded"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200000
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "video_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "poster_asset_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subtitle_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "entries"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "minLength": 2
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_ms",
                "end_ms",
                "text_key"
              ],
              "properties": {
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "text_key": {
                  "type": "string",
                  "minLength": 1
                },
                "speaker_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cue_id",
          "at_ms",
          "type"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "enum": [
              "visual_effect",
              "speaker_focus",
              "overlay_text"
            ]
          },
          "effect": {
            "enum": [
              "signal_glitch",
              "screen_flicker",
              "static_burst",
              "audio_distortion"
            ]
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "text_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completion_event_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "audio"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "media": {
            "required": [
              "audio_asset_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "video"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "media": {
            "required": [
              "video_asset_id"
            ]
          }
        }
      }
    }
  ]
}
