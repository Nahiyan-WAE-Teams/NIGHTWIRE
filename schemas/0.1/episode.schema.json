{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nightwire.game/episode/0.1/episode-descriptor.schema.json",
  "title": "Episode descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "episode_version",
    "title_key",
    "minimum_runtime_version",
    "entry_event",
    "default_locale",
    "supported_locales",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "episode_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "title_key": {
      "$ref": "#/$defs/key"
    },
    "description_key": {
      "$ref": "#/$defs/key"
    },
    "minimum_runtime_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "entry_event": {
      "type": "string",
      "minLength": 1
    },
    "default_locale": {
      "type": "string",
      "minLength": 2
    },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "manifest": {
      "const": "manifest.json"
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    }
  }
}
