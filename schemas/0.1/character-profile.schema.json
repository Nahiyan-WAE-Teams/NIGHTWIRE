{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nightwire.game/episode/0.1/character-profile.schema.json",
  "title": "Character profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_id",
    "display_name_key",
    "conversation_ids",
    "post_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$"
    },
    "display_name_key": {
      "type": "string",
      "minLength": 1
    },
    "bio_key": {
      "type": "string",
      "minLength": 1
    },
    "avatar_asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_key": {
      "type": "string",
      "minLength": 1
    },
    "conversation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
