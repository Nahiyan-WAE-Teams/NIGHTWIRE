{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nightwire.game/episode/0.1/conversation.schema.json",
  "title": "Conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "participants",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "$ref": "#/$defs/asset"
          },
          {
            "$ref": "#/$defs/choice"
          },
          {
            "$ref": "#/$defs/system"
          },
          {
            "$ref": "#/$defs/callInvitation"
          }
        ]
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "message_id",
        "type",
        "sender_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "text": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_key"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "text"
            },
            "sender_id": {
              "type": "string",
              "minLength": 1
            },
            "delay_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "text_key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "type",
        "sender_id",
        "asset_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "document"
          ]
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "caption_key": {
          "type": "string"
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "type",
        "sender_id",
        "prompt_key",
        "options"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "choice"
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_key": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "text_key"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "text_key": {
                "type": "string",
                "minLength": 1
              },
              "next_message_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "set_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "relationship_delta": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "type",
        "text_key"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "system"
        },
        "text_key": {
          "type": "string",
          "minLength": 1
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "callInvitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "type",
        "sender_id",
        "call_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "call_invitation"
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  }
}
